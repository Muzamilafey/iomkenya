NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/travel_assistance

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
JWT_COOKIE_NAME=hta_admin_token

MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.example/api/payments/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Admin email notifications (any SMTP provider: Gmail, Mailgun, SendGrid, SES…)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Portal Notifications <no-reply@your-domain.example>"

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=Super Admin
